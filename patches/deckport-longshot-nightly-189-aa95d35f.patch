+inline uint32_t mix(uint32_t a, uint32_t b, float t) {
+    t = std::min(std::max(t, 0.0f), 1.0f);
+    auto c = [&](int sh) { return (uint32_t)lroundf(((a >> sh) & 255) * (1 - t) + ((b >> sh) & 255) * t) << sh; };
+    return c(16) | c(8) | c(0);
