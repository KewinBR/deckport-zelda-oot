+int choice_index(const Item& it) {
+    if (!it.value || it.ch.empty()) return 0;
+    int best = 0, dist = 1 << 30;
+    for (size_t i = 0; i < it.ch.size(); i++) {
+        const int d = std::abs(it.ch[i].v - *it.value);
+        if (d < dist) dist = d, best = (int)i;
+    }
+    return best;
+}
