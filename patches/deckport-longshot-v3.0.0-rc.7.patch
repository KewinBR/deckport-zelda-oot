diff --git a/host/oot_barrier.c b/host/oot_barrier.c
new file mode 100644
index 00000000..06657509
--- /dev/null
+++ b/host/oot_barrier.c
@@ -0,0 +1,122 @@
+/* (longshot) OoT's job barriers wait for their masks instead of sleeping (host/oot_barrier.h has the protocol and why):
+   nx2/oot_patches.py patch_barrier_wait makes the lifted f_800998a0, f_800738e0 and f_8007e200 call hos_oot_barrier_wait in
+   place of the 20 us SleepThread of each of their five barrier loops, and hos_oot_barrier_wake right after each atomic OR
+   into a mask word those loops poll.
+
+   HOS_OOT_BARRIER_WAIT: unset or on, the waits (the default); off (0, false, off, no), the game's sleeps as before. Read
+   once, through hos_oot_barrier_on, the one place the hooks ask (HOS_AB may flip it there). */
+#include "hos.h"
+#ifndef LONGSHOT_ENV_H   /* (env_on: the switches' one rule) */
+#include "../gpu/vk/compat/longshot_env.h"
+#endif
+#include <stdlib.h>
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+/* (a wait's longest: the safety net, as the game's loop looks again after it. A wait ends at the OR that moves a word it
+   polls; only a word moved by code without the wake call waits this long. The game asked for 20 us, which Windows' timer
+   gave as ~0.5 ms; WaitOnAddress counts milliseconds) */
+#define OOT_BARRIER_TIMEOUT_NS 1000000
+
+#ifdef _WIN32
+/* (from kernelbase.dll, without linking Synchronization.lib, as gpu/vk/vk_replay.cpp's recorder waits) */
+typedef BOOL(WINAPI *BarrierWaitFn)(volatile VOID *, PVOID, SIZE_T, DWORD);
+typedef VOID(WINAPI *BarrierWakeFn)(PVOID);
+static BarrierWaitFn barrier_wait_fn;
+static BarrierWakeFn barrier_wake_fn;
+static int barrier_bind(void) {
+    const HMODULE k = GetModuleHandleA("kernelbase.dll");
+    if (!k) return 0;
+    barrier_wait_fn = (BarrierWaitFn)(void *)GetProcAddress(k, "WaitOnAddress");
+    barrier_wake_fn = (BarrierWakeFn)(void *)GetProcAddress(k, "WakeByAddressAll");
+    return barrier_wait_fn && barrier_wake_fn;
+}
+#define OOT_BARRIER_WAIT_ON(a, v, ms) \
+    do { uint32_t seen_ = (v); barrier_wait_fn((volatile VOID *)(a), &seen_, 4, (DWORD)(ms)); } while (0)
+#define OOT_BARRIER_WAKE_ALL(a) barrier_wake_fn((PVOID)(uintptr_t)(a))
+#else
+/* (host/posix's WaitOnAddress and WakeByAddressAll: a futex on the word) */
+static int barrier_bind(void) { return 1; }
+#define OOT_BARRIER_WAIT_ON(a, v, ms) \
+    do { uint32_t seen_ = (v); WaitOnAddress((volatile void *)(a), &seen_, 4, (DWORD)(ms)); } while (0)
+#define OOT_BARRIER_WAKE_ALL(a) WakeByAddressAll((void *)(uintptr_t)(a))
+#endif
+#define OOT_BARRIER_NOW_NS() hos_now_ns()
+#include "oot_barrier.h"
+
+static OotBarrier barrier;
+static int barrier_mode = -1;   /* (-1 not read yet, 0 off, 1 on) */
+static int barrier_bound;       /* (WaitOnAddress found: set before barrier_mode, read after it) */
+static volatile long long barrier_how[3], barrier_waited_ns, barrier_wakes;
+
+/* whether the hooks wait (1) or the game sleeps as before (0): HOS_OOT_BARRIER_WAIT, read once, and HOS_AB may flip it.
+   The one function the lifted code asks. WaitOnAddress is looked up whatever the switch says, so a flip to on mid-run has
+   it; a flip to off leaves a waiter to its timeout (no wake comes while off), at most 1 ms.
+   (longshot) On by default (18 Nov): in-run A/Bs standing in Castle Town's market, 4 cores: frame time -3.2 % in both runs
+   (frames of 16.7 ms or more 30 -> 19 % and 26 -> 16 %); 16 cores: no difference either way (+0.04 and +0.01 ms, both
+   intervals around 0). HOS_OOT_BARRIER_WAIT=0: the game's sleeps, as before. */
+int hos_oot_barrier_on(void) {
+    int m = __atomic_load_n(&barrier_mode, __ATOMIC_ACQUIRE);
+    if (__builtin_expect(m < 0, 0)) {
+        const char *e = getenv("HOS_OOT_BARRIER_WAIT");
+        m = !(e && env_value_off(e));
+        barrier_bound = barrier_bind();
+        if (m && !barrier_bound) {
+            hos_log("barrier: no WaitOnAddress on this system: the game's job barriers sleep as before");
+            m = 0;
+        }
+        int unset = -1;
+        if (__atomic_compare_exchange_n(&barrier_mode, &unset, m, 0, __ATOMIC_RELEASE, __ATOMIC_ACQUIRE) && m)
+            hos_log("barrier: the game's job barriers (f_800998a0, f_800738e0, f_8007e200) wait until their masks move "
+                    "instead of sleeping 20 us (HOS_OOT_BARRIER_WAIT)");
+        m = __atomic_load_n(&barrier_mode, __ATOMIC_ACQUIRE);
+    }
+    return barrier_bound ? hos_ab_value("HOS_OOT_BARRIER_WAIT", m) : 0;
+}
+
+static void barrier_count(int how, int64_t waited) {
+    __atomic_add_fetch(&barrier_how[how], 1, __ATOMIC_RELAXED);
+    if (waited) __atomic_add_fetch(&barrier_waited_ns, waited, __ATOMIC_RELAXED);
+    const long long n0 = barrier_how[0], n1 = barrier_how[1], n2 = barrier_how[2];
+    /* (every 16,384 waits that waited: the barrier sleeps came ~1,400 times a second standing in the market on 4 logical
+       processors, from the 17 Nov samples, so about every 12 s) */
+    if (how != OOT_BARRIER_AT_ONCE && !((n1 + n2) & 16383))
+        hos_log("barrier: %lld looks: %lld found the masks moved already, %lld waited until they moved, %lld for the whole "
+                "%d ms (a wait %.0f us on average); %lld wakes", n0 + n1 + n2, n0, n1, n2, OOT_BARRIER_TIMEOUT_NS / 1000000,
+                barrier_waited_ns / 1e3 / (double)(n1 + n2), barrier_wakes);
+}
+
+/* In place of the barrier's SleepThread. p: the job block; off1, off2: the offsets in it of the mask words the loop polls
+   (the same twice for one word); seen1, seen2: their values when the loop's pass looked; full: the value at which the loop
+   leaves. 1: the wait was done here (the loop then looks again, without the sleep); 0: the switch is off (the sleep runs) */
+int hos_oot_barrier_wait(uint64_t p, uint32_t off1, uint32_t seen1, uint32_t off2, uint32_t seen2, uint32_t full) {
+    if (!hos_oot_barrier_on()) return 0;
+    volatile uint32_t *const w[OOT_BARRIER_WORDS] = {(volatile uint32_t *)GP(p + off1), (volatile uint32_t *)GP(p + off2)};
+    const uint32_t seen[OOT_BARRIER_WORDS] = {seen1, seen2};
+    const int n = off1 == off2 ? 1 : 2;
+    if (oot_barrier_moved(w, seen, n, full)) {   /* (moved since the pass looked: back to the loop, the core kept) */
+        barrier_count(OOT_BARRIER_AT_ONCE, 0);
+        return 1;
+    }
+    extern volatile int hos_fps_timing;   /* (host/hos_thread.c: the FPS counter's Breakdown counts the guest's sleeps) */
+    extern _Thread_local int64_t hos_slept_ns[2];
+    const int64_t t0 = hos_now_ns();
+    HOS_CHAIN(HOS_CHAIN_WAIT, p);
+    const int away = hos_vcore_away();   /* (the core given up, as a sleep does) */
+    const int how = oot_barrier_wait(&barrier, p, w, seen, n, full, OOT_BARRIER_TIMEOUT_NS);
+    if (away) hos_vcore_back();
+    HOS_CHAIN(HOS_CHAIN_WOKE, p);
+    const int64_t waited = hos_now_ns() - t0;
+    if (hos_fps_timing) hos_slept_ns[1] += waited;
+    barrier_count(how, waited > 0 ? waited : 1);
+    return 1;
+}
+
+/* Right after an atomic OR into a polled mask word of job block p */
+void hos_oot_barrier_wake(uint64_t p) {
+    if (!hos_oot_barrier_on()) return;
+    if (oot_barrier_wake(&barrier, p)) {
+        HOS_CHAIN(HOS_CHAIN_SIGNAL, p);
+        __atomic_add_fetch(&barrier_wakes, 1, __ATOMIC_RELAXED);
+    }
+}
diff --git a/host/oot_barrier.h b/host/oot_barrier.h
new file mode 100644
index 00000000..1875edd1
--- /dev/null
+++ b/host/oot_barrier.h
@@ -0,0 +1,105 @@
+/* (longshot) OoT's job barriers: a wait that ends when the work it waits for is done, in place of the game's 20 us sleep
+   (HOS_OOT_BARRIER_WAIT; host/oot_barrier.c is the glue, nx2/oot_patches.py patch_barrier_wait puts in the calls).
+
+   Three of the game's parallel-for jobs (f_800998a0, f_800738e0, f_8007e200) run on several threads at once over one job
+   block P: each pass over the job's items takes an item and marks its progress with an atomic OR into a bitmask in P, and a
+   thread with nothing left to take sleeps 20 us (nn::os::SleepThread) and looks again, until the masks it polls are full.
+   On Windows with few logical processors a sleep under a millisecond waits on the timer and wakes ~0.5 ms late
+   (host/hos_thread.c sleep_ns), so each look came late: on 4 logical processors, standing in Castle Town's market, the
+   main thread was asleep at those sleeps in 11.4 % of its samples (~2 ms a frame). Making the main thread's short sleeps
+   yield instead raised its CPU from 22-29 % to 33-37 % of a core and did not shorten the frame (18 Nov, the same scene,
+   two rounds an arm): what is wanted is a wake at the moment the work is done, with no CPU spent until then.
+
+   Here a thread with nothing left waits on a word of the host's, a slot of a small table keyed by P, until a mask word
+   it polls differs from what its pass saw, or every one is full, or a timeout; a thread that ORs into a polled word wakes
+   the slot's waiters right after the OR. The game's own loop is kept: after the wait it looks at the masks again and
+   takes what there is, as after its sleep, so a wait that ends early (a wake for another job in the same slot, a timeout)
+   costs a look and nothing else.
+
+   No lost wake-up (every load and read-modify-write here sequentially consistent, and the waker fenced after its OR):
+     waiter: waiters += 1 (armed); then, in a loop: g = gen; look at the words (they moved: done); wait while gen == g
+     waker:  OR into the word (the lifted code); fence; if waiters: gen += 1, wake every waiter on gen
+   If the waker reads waiters == 0, its OR comes before the arming in the one order of these operations, so the waiter's
+   first look after arming sees it. Otherwise it moves gen and wakes: a waiter whose g was read after the move sees the
+   OR in the look that follows it; one whose g was read before finds gen != g when the wait compares (and returns at
+   once) or is asleep on gen and is woken. A wake on gen with no move of a polled word (another job of the slot, a
+   spurious wake of the OS) is looked at and waited again inside the wait, without going back to the game.
+
+   The includer gives the platform's wait and wake (OOT_BARRIER_WAIT_ON(address of a uint32_t, the value it must still
+   hold, ms), which returns at once when the word differs, and OOT_BARRIER_WAKE_ALL(address)) and the clock
+   (OOT_BARRIER_NOW_NS()). OOT_BARRIER_ARMING() runs just before the arming and OOT_BARRIER_LOOKED() between a look and
+   the wait after it: nothing in the game, a test pauses there to put a wake in each window. */
+#ifndef OOT_BARRIER_H
+#define OOT_BARRIER_H
+#include <stdint.h>
+
+#ifndef OOT_BARRIER_ARMING
+#define OOT_BARRIER_ARMING() ((void)0)
+#endif
+#ifndef OOT_BARRIER_LOOKED
+#define OOT_BARRIER_LOOKED() ((void)0)
+#endif
+
+enum { OOT_BARRIER_SLOTS = 64, OOT_BARRIER_WORDS = 2 };
+/* how a wait ended: the words had moved before it began (no wait), they moved while it waited, or its time ran out */
+enum { OOT_BARRIER_AT_ONCE, OOT_BARRIER_MOVED, OOT_BARRIER_TIMED_OUT };
+
+typedef struct OotBarrierSlot {
+    _Alignas(64) volatile uint32_t gen;   /* (its own cache line: the jobs' threads move it at their ORs) */
+} OotBarrierSlot;
+typedef struct OotBarrier {
+    OotBarrierSlot slot[OOT_BARRIER_SLOTS];
+    _Alignas(64) volatile int32_t waiters;   /* (threads armed in a wait, every slot: the wakers' one load when none waits) */
+} OotBarrier;
+
+/* the slot of a job block (P, a guest address: blocks are at least 64 bytes apart) */
+static inline OotBarrierSlot *oot_barrier_slot(OotBarrier *b, uint64_t key) {
+    return &b->slot[(uint32_t)(key >> 6 ^ key >> 12 ^ key >> 18) % OOT_BARRIER_SLOTS];
+}
+
+/* 1 when a polled word differs from what the pass saw (w[i] against seen[i]), or every one is full: the game's loop then
+   has something to look at */
+static inline int oot_barrier_moved(volatile uint32_t *const *w, const uint32_t *seen, int n, uint32_t full) {
+    int all_full = 1;
+    for (int i = 0; i < n; i++) {
+        const uint32_t v = __atomic_load_n(w[i], __ATOMIC_SEQ_CST);
+        if (v != seen[i]) return 1;
+        all_full &= v == full;
+    }
+    return all_full;
+}
+
+/* Waits until a polled word moves (oot_barrier_moved) or timeout_ns passes; the caller has looked at the words already and
+   given its virtual core up. OOT_BARRIER_MOVED or OOT_BARRIER_TIMED_OUT */
+static inline int oot_barrier_wait(OotBarrier *b, uint64_t key, volatile uint32_t *const *w, const uint32_t *seen, int n,
+                                   uint32_t full, int64_t timeout_ns) {
+    OotBarrierSlot *s = oot_barrier_slot(b, key);
+    const int64_t end = OOT_BARRIER_NOW_NS() + timeout_ns;
+    int how = OOT_BARRIER_TIMED_OUT;
+    OOT_BARRIER_ARMING();
+    __atomic_add_fetch(&b->waiters, 1, __ATOMIC_SEQ_CST);
+    for (;;) {
+        const uint32_t g = __atomic_load_n(&s->gen, __ATOMIC_SEQ_CST);
+        if (oot_barrier_moved(w, seen, n, full)) {   /* (the look after arming: a change before it is never missed) */
+            how = OOT_BARRIER_MOVED;
+            break;
+        }
+        const int64_t left = end - OOT_BARRIER_NOW_NS();
+        if (left <= 0) break;
+        OOT_BARRIER_LOOKED();
+        OOT_BARRIER_WAIT_ON(&s->gen, g, (uint32_t)((left + 999999) / 1000000));
+    }
+    __atomic_sub_fetch(&b->waiters, 1, __ATOMIC_SEQ_CST);
+    return how;
+}
+
+/* After an OR into a polled word of job block key: wakes the slot's waiters (1), or nothing when no thread waits (0) */
+static inline int oot_barrier_wake(OotBarrier *b, uint64_t key) {
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);   /* (the OR before it, whatever order the lift gave it) */
+    if (!__atomic_load_n(&b->waiters, __ATOMIC_SEQ_CST)) return 0;
+    OotBarrierSlot *s = oot_barrier_slot(b, key);
+    __atomic_add_fetch(&s->gen, 1, __ATOMIC_SEQ_CST);
+    OOT_BARRIER_WAKE_ALL(&s->gen);
+    return 1;
+}
+#endif
