+void paint(ui::Ctx& c) {
+    DL = c.d, FN = c.f, W = (uint32_t)c.w, H = (uint32_t)c.h, K = std::min(c.w / 1280.0f, c.h / 800.0f);
+    const uint32_t w = W, h = H;
