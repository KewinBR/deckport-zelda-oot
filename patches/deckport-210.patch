+    auto hint = [&](const char* label, const char* g, bool rect, uint32_t c, Rect* r) {
+        const int gw = rect ? text_w(g, 12, true) + S(10) : S(24);
+        x -= gw;
+        glyph(x, cy, g, rect);
+        const int lw = text_w(label, 20, false);
