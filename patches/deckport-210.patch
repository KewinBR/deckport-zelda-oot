+        n_rows = (int)s.items.size();
+        if (s.type == S_PRESET) paint_preset_table(cx, ry + S(6), cw);
+        const Item* hi = s.items.empty() ? nullptr : &s.items[zone == 1 ? row[tab] : 0];
+        paint_hint(cx, py + ph - S(118), cw, hi);
