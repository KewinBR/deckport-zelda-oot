+void apply_restart() {
+    msg_restarting = true;
+    save();
+    pipeline_cache_save(true);
+    if (FILE* f = fopen((game_dir() + "deckport_reiniciar").c_str(), "w")) fputs("1\n", f), fclose(f);
+    logf("menu (Deckport): aplicar e reiniciar");
