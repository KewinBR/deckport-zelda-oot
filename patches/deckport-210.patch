+void paint(ui::Ctx& c) {
+    DL = c.d, FN = c.f, W = (uint32_t)c.w, H = (uint32_t)c.h, K = std::min(c.w / 1280.0f, c.h / 800.0f);
+    const uint32_t w = W, h = H;
+    start();
+    box(0, 0, (int)w, (int)h, C_NIGHT);
+    for (int i = 30; i >= 1; i--) disc(w * 0.7f, h * 0.55f, h * 0.025f * i, rgb(52, 32, 16), 0.035f);
