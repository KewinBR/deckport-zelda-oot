+    lab(false, y + S(108), "R2", true, "Usar o item");
+    lab(false, y + S(152), "L1", true, "Trocar de aba");
+    lab(true, y + S(20), "=", false, "Abrir o menu");
+    lab(true, y + S(64), "B", false, "Ações e correr");
+    lab(true, y + S(108), "A", false, "Guardar");
