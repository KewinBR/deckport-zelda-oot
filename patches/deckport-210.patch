+        x -= S(28);
+    };
+    r_y = r_b = r_a = {0, 0, 0, 0};
+    hint(zone == 1 ? "Voltar" : "Fechar", "B", false, C_IVORY, &r_b);
+    const Section& s = tabs[tab].secs[sec[tab]];
+    if (zone == 0 && !s.items.empty()) hint("Selecionar", "A", false, C_IVORY, &r_a);
+    if (zone == 1) hint("Mudar", "<  >", true, C_IVORY, nullptr);
