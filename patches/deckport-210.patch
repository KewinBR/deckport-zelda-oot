+    else {
+        int ry = cy;
+        for (size_t i = 0; i < s.items.size(); i++) {
+            paint_row(cx, ry, cw, s.items[i], zone == 1 && (int)i == row[tab]);
+            r_rows[i] = {cx, ry, cw, S(46)};
+            ry += S(52);
